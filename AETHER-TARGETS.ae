# Target contracts. Native means existing backend can execute without a new host adapter.
fn TARGET_describe(name)
  return U_target(name)
fn TARGET_wasm(entry)
  let a=U_app("aether-wasm","wasm",entry)
  return U_buildPlan(U_manifest(a,"5.0.0",["AETHER-IR","deterministic","wasm"]))
fn TARGET_android(entry)
  let a=U_app("aether-android","android",entry)
  a=U_permission(a,"INTERNET")
  return U_buildPlan(U_manifest(a,"5.0.0",["AETHER-IR","android","apk/aab-adapter"]))
fn TARGET_desktop(entry,target)
  let a=U_app("aether-desktop",target,entry)
  return U_buildPlan(U_manifest(a,"5.0.0",["AETHER-IR","desktop","native-adapter"]))
fn TARGET_embedded(entry)
  let a=U_app("aether-embedded","embedded",entry)
  return U_buildPlan(U_manifest(a,"5.0.0",["AETHER-IR","firmware-adapter"]))
