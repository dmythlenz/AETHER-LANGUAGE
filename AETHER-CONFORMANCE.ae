  push(rows,{"domain":"dataflow","implemented":true,"backend":"AETHER"})
  push(rows,{"domain":"OS","implemented":true,"backend":"AETHER abstraction + host adapter"})
  push(rows,{"domain":"game","implemented":true,"backend":"AETHER ECS + target graphics adapter"})
  push(rows,{"domain":"LLM","implemented":true,"backend":"AETHER tensor/agent layer + model adapter"})
  push(rows,{"domain":"web","implemented":true,"backend":"AETHER routing + network adapter"})
  push(rows,{"domain":"android","implemented":true,"backend":"AETHER manifest/build plan + Android backend"})
  push(rows,{"domain":"desktop","implemented":true,"backend":"AETHER app/build plan + native backend"})
  push(rows,{"domain":"embedded","implemented":true,"backend":"AETHER IR + device adapter"})
