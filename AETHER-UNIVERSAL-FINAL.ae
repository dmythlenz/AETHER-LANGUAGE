# ============================================================================
# AETHER UNIVERSAL FINAL v3.0.2
# One-language application fabric: language, OS, games, AI/LLM, web, mobile,
# desktop, data, networking, storage, observability and deterministic builds.
# All implementation in AETHER. Host calls are isolated behind adapters.
# ============================================================================
let AETHER_VERSION = "3.0.2"
let AETHER_ABI = "AETHER-UNIVERSAL/3"

# ---- common values ----------------------------------------------------------
fn ok(v)
  let r = {}
  r = put(r, "ok", true)
  r = put(r, "value", v)
  return r
fn err(code, message)
  let r = {}
  r = put(r, "ok", false)
  r = put(r, "code", code)
  r = put(r, "message", message)
  return put(r, "value", 0)
fn isOk(r)
  return get(r, "ok") == true
fn unwrap(r)
  if isOk(r)
    return get(r, "value")
  return 0

fn fingerprint(s)
  let n=len(s)
  let p=substr(s,0,min(n,8))
  return "ae3:"+str(n)+":"+p


# ---- type/contracts ---------------------------------------------------------
fn kind(v)
  let t = type(v)
  if t == "number" return "Number"
  if t == "string" return "String"
  if t == "boolean" return "Bool"
  if t == "list" return "List"
  if t == "dict" return "Dict"
  if t == "array" return "List"
  if t == "object" return "Dict"
  return str(t)
fn require(v, wanted)
  if wanted == "Any" || kind(v) == wanted
    return ok(v)
  return err("TYPE", "expected " + wanted + " got " + kind(v))

# ---- capability/security kernel --------------------------------------------
fn cap(name, scope)
  let c = put({}, "name", name)
  c = put(c, "scope", scope)
  return put(c, "id", "cap:" + fingerprint(name + ":" + scope))
fn hasCap(caps, name, scope)
  let i = 0
  while i < len(caps)
    let c = get(caps, i)
    if get(c, "name") == name && (get(c, "scope") == scope || get(c, "scope") == "*")
      return true
    i += 1
  return false
fn securityProfile()
  mut c = []
  push(c, cap("compute", "*"))
  return c

# ---- universal resources / processes ---------------------------------------
fn process(pid, name, state)
  let p = put({}, "pid", pid)
  p = put(p, "name", name)
  p = put(p, "state", state)
  p = put(p, "cpu", 0)
  p = put(p, "memory", 0)
  return put(p, "caps", securityProfile())
fn processStart(p)
  return put(p, "state", "running")
fn processStop(p)
  return put(p, "state", "stopped")
fn resource(name, capacity)
  let r = put({}, "name", name)
  r = put(r, "capacity", capacity)
  r = put(r, "used", 0)
  return put(r, "version", 0)
fn resourceReserve(r, amount)
  if get(r, "used") + amount > get(r, "capacity")
    return err("RESOURCE", get(r, "name") + " exhausted")
  r = put(r, "used", get(r, "used") + amount)
  r = put(r, "version", get(r, "version") + 1)
  return ok(r)

# ---- event/signal fabric ----------------------------------------------------
fn bus()
  return put(put({}, "clock", 0), "events", [])
fn emit(b, topic, payload)
  let n = get(b, "clock") + 1
  let e = put({}, "id", "evt:" + fingerprint(topic + ":" + str(n)))
  e = put(e, "seq", n)
  e = put(e, "topic", topic)
  e = put(e, "payload", payload)
  push(get(b, "events"), e)
  b = put(b, "clock", n)
  return b
fn signal(name, value)
  let s = put({}, "name", name)
  s = put(s, "value", value)
  return put(s, "version", 0)
fn signalSet(s, value)
  s = put(s, "value", value)
  return put(s, "version", get(s, "version") + 1)

# ---- deterministic graph executor -----------------------------------------
fn graph()
  let g = put({}, "nodes", [])
  g = put(g, "tick", 0)
  g = put(g, "errors", 0)
  return put(g, "done", 0)
fn node(id, op, args, deps, priority)
  let n = put({}, "id", id)
  n = put(n, "op", op)
  n = put(n, "args", args)
  n = put(n, "deps", deps)
  n = put(n, "priority", priority)
  n = put(n, "status", "pending")
  n = put(n, "value", 0)
  return put(n, "error", "")
fn findNode(ns, id)
  let i = 0
  while i < len(ns)
    if get(get(ns, i), "id") == id return i
    i += 1
  return -1
fn addNode(g, n)
  let ns = get(g, "nodes")
  if findNode(ns, get(n, "id")) < 0 push(ns, n)
  return put(g, "nodes", ns)
fn ready(n, ns)
  if get(n, "status") != "pending" return false
  let ds = get(n, "deps")
  let i = 0
  while i < len(ds)
    let j = findNode(ns, get(ds, i))
    if j < 0 || get(get(ns, j), "status") != "done" return false
    i += 1
  return true
fn choose(g)
  let ns = get(g, "nodes")
  let best = 0
  let i = 0
  while i < len(ns)
    let n = get(ns, i)
    if ready(n, ns)
      if best == 0 || get(n, "priority") > get(best, "priority") || (get(n, "priority") == get(best, "priority") && str(get(n,"id")) < str(get(best,"id")))
        best = n
    i += 1
  return best
fn valuesFor(n, ns)
  mut out=[]
  let ds=get(n,"deps")
  let i=0
  while i<len(ds)
    push(out,get(get(ns,findNode(ns,get(ds,i))),"value"))
    i+=1
  return out
fn execute(op,args,ds)
  if op=="const" return ok(get(args,0))
  if op=="add" return ok(get(ds,0)+get(ds,1))
  if op=="sub" return ok(get(ds,0)-get(ds,1))
  if op=="mul" return ok(get(ds,0)*get(ds,1))
  if op=="div"
    if get(ds,1)==0 return err("DIV0","division by zero")
    return ok(get(ds,0)/get(ds,1))
  if op=="sum"
    mut total=0
    let xs=get(ds,0)
    let i=0
    while i<len(xs)
      total+=get(xs,i)
      i+=1
    return ok(total)
  return err("OP","unknown " + str(op))
fn stepGraph(g)
  let n=choose(g)
  if n==0 return [g,false]
  let ns=get(g,"nodes")
  let i=findNode(ns,get(n,"id"))
  n=put(n,"status","running")
  ns=put(ns,i,n)
  let r=execute(get(n,"op"),get(n,"args"),valuesFor(n,ns))
  if isOk(r)
    n=put(n,"status","done")
    n=put(n,"value",unwrap(r))
  else
    n=put(n,"status","error")
    n=put(n,"error",get(r,"message"))
    g=put(g,"errors",get(g,"errors")+1)
  ns=put(ns,i,n)
  g=put(g,"nodes",ns)
  g=put(g,"tick",get(g,"tick")+1)
  if isOk(r) g=put(g,"done",get(g,"done")+1)
  return [g,true]
fn runGraph(g, budget)
  mut s=g
  let i=0
  while i<budget
    let r=stepGraph(s)
    s=get(r,0)
    if get(r,1)==false return s
    i+=1
  return s

# ---- storage/database/network abstractions ---------------------------------
fn kvStore()
  return put({}, "data", {})
fn kvPut(s,k,v)
  put(get(s,"data"),k,v)
  return s
fn kvGet(s,k)
  let v=get(get(s,"data"),k)
  return ok(v)
fn route(method,path)
  let r=put({},"method",method)
  r=put(r,"path",path)
  return put(r,"id","route:"+fingerprint(method+path))
fn httpRequest(method,url,body)
  let r=route(method,url)
  r=put(r,"body",body)
  r=put(r,"status",0)
  r=put(r,"requiresAdapter",true)
  return ok(r)

# ---- game engine: ECS + deterministic fixed-step loop ----------------------
fn world()
  let w=put({},"time",0)
  w=put(w,"entities",[])
  w=put(w,"systems",[])
  return put(w,"events",bus())
fn entity(id)
  return put({},"id",id)
fn addComponent(e,name,data)
  put(e,name,data)
  return e
fn addEntity(w,e)
  push(get(w,"entities"),e)
  return w
fn addSystem(w,name,priority)
  let s=put({},"name",name)
  s=put(s,"priority",priority)
  push(get(w,"systems"),s)
  return w
fn gameStep(w,dt)
  w=put(w,"time",get(w,"time")+dt)
  let i=0
  while i<len(get(w,"entities"))
    let e=get(get(w,"entities"),i)
    if get(e,"velocity") != 0 && get(e,"position") != 0
      let p=get(e,"position")
      let v=get(e,"velocity")
      e=put(e,"position",{"x":get(p,"x")+get(v,"x")*dt,"y":get(p,"y")+get(v,"y")*dt,"z":get(p,"z")+get(v,"z")*dt})
      put(get(w,"entities"),i,e)
    i+=1
  return w

# ---- tensor/LLM substrate ---------------------------------------------------
fn tensor(shape,data)
  let t=put({},"shape",shape)
  t=put(t,"rank",len(shape))
  return put(t,"data",data)
fn tensorScale(t,k)
  mut out=[]
  let d=get(t,"data")
  let i=0
  while i<len(d)
    push(out,get(d,i)*k)
    i+=1
  return tensor(get(t,"shape"),out)
fn dot(a,b)
  if len(a)!=len(b) return err("SHAPE","dot")
  mut s=0
  let i=0
  while i<len(a)
    s+=get(a,i)*get(b,i)
    i+=1
  return ok(s)
fn matmul(a,b)
  let sa=get(a,"shape")
  let sb=get(b,"shape")
  if len(sa)!=2 || len(sb)!=2 return err("SHAPE","matmul requires rank-2 tensors")
  if get(sa,1)!=get(sb,0) return err("SHAPE","matmul")
  let ar=get(sa,0)
  let ac=get(sa,1)
  let bc=get(sb,1)
  mut out=[]
  let r=0
  while r<ar
    let c=0
    while c<bc
      mut z=0
      let k=0
      while k<ac
        z+=get(get(a,"data"),r*ac+k)*get(get(b,"data"),k*bc+c)
        k+=1
      push(out,z)
      c+=1
    r+=1
  return ok(tensor([ar,bc],out))
fn normalize(v)
  mut s=0
  let i0=0
  while i0<len(v)
    s+=get(v,i0)
    i0+=1
  if s==0 return err("ZERO_NORM","normalize")
  mut out=[]
  let i=0
  while i<len(v)
    push(out,get(v,i)/s)
    i+=1
  return ok(out)
fn normL2(v)
  mut s=0
  let i=0
  while i<len(v)
    let x=get(v,i)
    s+=x*x
    i+=1
  if s==0 return err("ZERO_NORM","normL2")
  return ok(sqrt(s))
fn softmax(v)
  if len(v)==0 return err("EMPTY","softmax")
  mut m=get(v,0)
  let i=1
  while i<len(v)
    if get(v,i)>m m=get(v,i)
    i+=1
  mut ex=[]
  mut z=0
  let j=0
  while j<len(v)
    let e=exp(get(v,j)-m)
    push(ex,e)
    z+=e
    j+=1
  if z==0 return err("SOFTMAX","underflow")
  mut out=[]
  let k=0
  while k<len(ex)
    push(out,get(ex,k)/z)
    k+=1
  return ok(out)
# q is [D], keys is tensor [N,D], values is tensor [N,V].
fn attention(q,keys,values)
  let ks=get(keys,"shape")
  let vs=get(values,"shape")
  if len(ks)!=2 || len(vs)!=2 return err("SHAPE","attention requires rank-2 keys/values")
  if len(q)!=get(ks,1) return err("SHAPE","query/key width mismatch")
  if get(ks,0)!=get(vs,0) return err("SHAPE","key/value row mismatch")
  let rows=get(ks,0)
  let width=get(ks,1)
  let outWidth=get(vs,1)
  mut scores=[]
  let scale=sqrt(width)
  let qi=0
  while qi<rows
    mut score=0
    let qj=0
    while qj<width
      score+=get(q,qj)*get(get(keys,"data"),qi*width+qj)
      qj+=1
    push(scores,score/scale)
    qi+=1
  let probs=softmax(scores)
  if !isOk(probs) return probs
  mut out=[]
  let c=0
  while c<outWidth
    mut total=0
    let r=0
    while r<rows
      total+=get(get(probs,"value"),r)*get(get(values,"data"),r*outWidth+c)
      r+=1
    push(out,total)
    c+=1
  return ok(tensor([1,outWidth],out))
fn llmConfig(name,dim,layers,heads)
  let c=put({},"name",name)
  c=put(c,"dim",dim)
  c=put(c,"layers",layers)
  return put(c,"heads",heads)
fn llmRoute(intent)
  if startsWith(intent,"chat:") return "llm.generate"
  if startsWith(intent,"embed:") return "llm.embed"
  if startsWith(intent,"retrieve:") return "rag.retrieve"
  if startsWith(intent,"code:") return "llm.code"
  return "llm.general"
fn llmInferenceRequest(cfg,input)
  let r=put({},"model",get(cfg,"name"))
  r=put(r,"input",input)
  r=put(r,"route",llmRoute("chat:"+str(input)))
  return put(r,"requiresAdapter",true)
fn llmInfer(cfg,input)
  return err("ADAPTER_REQUIRED","LLM weight execution requires a tensor/model backend")

# ---- AI agent/tool orchestration -------------------------------------------
fn tool(name, capability)
  let t=put({},"name",name)
  return put(t,"capability",capability)
fn agent(name, tools)
  let a=put({},"name",name)
  a=put(a,"tools",tools)
  return put(a,"memory",kvStore())
fn agentMemoryPut(a,k,v)
  a=put(a,"memory",kvPut(get(a,"memory"),k,v))
  return a

# ---- UI/application model --------------------------------------------------
fn app(name,target)
  let a=put({},"name",name)
  a=put(a,"target",target)
  a=put(a,"version","1.0.0")
  a=put(a,"screens",[])
  return put(a,"permissions",[])
fn screen(a,name)
  let s=put({},"name",name)
  push(get(a,"screens"),s)
  return a
fn permission(a,p)
  push(get(a,"permissions"),p)
  return a

# ---- build/package graph ---------------------------------------------------
fn manifest(name,version,target,entry)
  let m=put({},"name",name)
  m=put(m,"version",version)
  m=put(m,"target",target)
  return put(m,"entry",entry)
fn packagePlan(m)
  mut steps=[]
  push(steps,["parse",get(m,"entry")])
  push(steps,["analyze",get(m,"entry")])
  push(steps,["lower","AETHER-IR"])
  push(steps,["optimize","deterministic"])
  push(steps,["backend",get(m,"target")])
  push(steps,["package",get(m,"name")+"-"+get(m,"version")])
  return steps
fn targetCapabilities(target)
  if target=="wasm" return ["browser","node","wasmtime"]
  if target=="android" return ["mobile","apk/aab backend"]
  if target=="windows" return ["desktop","native/window"]
  if target=="linux" return ["desktop","server"]
  if target=="embedded" return ["device","cross-target"]
  return ["virtual"]

# ---- compiler IR ------------------------------------------------------------
fn ir(op,args,typ)
  let n=put({},"op",op)
  n=put(n,"args",args)
  n=put(n,"type",typ)
  return put(n,"id","ir:"+fingerprint(str(op)+str(args)+str(typ)))
fn typeCheck(v,wanted)
  return require(v,wanted)
fn lowerLiteral(v)
  return ir("const",[v],kind(v))
fn lowerBinary(op,a,b)
  let t="Number"
  return ir("bin:"+op,[a,b],t)
fn compilePlan(src,target)
  let m=manifest("aether-app","3.0.2",target,"main.ae")
  let p=packagePlan(m)
  return put(put(put({},"source",src),"target",target),"pipeline",p)

# ---- observability/debug ---------------------------------------------------
fn metric(name,value)
  let m=put({},"name",name)
  m=put(m,"value",value)
  return put(m,"version",1)
fn trace(name,payload)
  let t=put({},"name",name)
  t=put(t,"payload",payload)
  return put(t,"id","trace:"+fingerprint(name+str(payload)))
fn health(name,okv,message)
  let h=put({},"service",name)
  h=put(h,"ok",okv)
  return put(h,"message",message)

# ---- deterministic snapshot ------------------------------------------------
fn snapshot(name,state)
  let id="snap:"+fingerprint(name+str(state))
  return put(put({},"id",id),"state",state)

# ---- universal self-test ---------------------------------------------------
fn selfTest()
  let a=addNode(addNode(graph(),node("a","const",[2],[],10)),node("b","const",[3],[],10))
  a=addNode(a,node("c","add",[],["a","b"],20))
  a=runGraph(a,8)
  let cr=get(a,"nodes")
  let c=get(cr,findNode(cr,"c"))
  let r=matmul(tensor([1,2],[2,3]),tensor([2,1],[4,5]))
  let checks=[]
  push(checks,get(c,"value")==5)
  push(checks,isOk(r))
  push(checks,get(get(get(r,"value"),"data"),0)==23)
  push(checks,get(targetCapabilities("android"),0)=="mobile")
  mut pass=0
  let i=0
  while i<len(checks)
    if get(checks,i) pass+=1
    i+=1
  return put(put({},"passed",pass),"total",len(checks))

print "AETHER UNIVERSAL FINAL " + AETHER_VERSION
print "Self-test = " + str(selfTest())
