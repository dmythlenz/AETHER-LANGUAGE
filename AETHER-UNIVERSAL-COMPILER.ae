# AETHER-native compiler architecture.
# This file defines a real lexical front-end and typed IR records.
# Full AST lowering for every existing language construct remains a compiler milestone.
fn token(kind,value,line,col)
  let t=put({},"kind",kind)
  t=put(t,"value",value)
  t=put(t,"line",line)
  return put(t,"col",col)
fn isAlpha(c)
  let letters="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
  return contains(letters,c)
fn isDigit(c)
  return contains("0123456789",c)
fn isSpace(c)
  return c==" " || c=="\t" || c=="\r"
fn isTwoCharOp(a,b)
  let x=a+b
  return x=="==" || x=="!=" || x=="<=" || x==">=" || x=="&&" || x=="||" || x=="=>" || x=="->" || x=="::" || x=="??"
fn lex(src)
  mut out=[]
  let mut_i=0
  mut i=mut_i
  let line0=1
  mut line=line0
  mut col=1
  while i<len(src)
    let c=substr(src,i,1)
    if isSpace(c)
      i+=1
      col+=1
    else if c=="\n"
      i+=1
      line+=1
      col=1
    else if c=="#"
      while i<len(src) && substr(src,i,1)!="\n"
        i+=1
        col+=1
    else if c=="\""
      let sc=col
      let sl=line
      let s=i+1
      i+=1
      col+=1
      while i<len(src) && substr(src,i,1)!="\""
        if substr(src,i,1)=="\n"
          line+=1
          col=1
        else
          col+=1
        i+=1
      push(out,token("string",substr(src,s,i-s),sl,sc))
      if i<len(src)
        i+=1
        col+=1
    else if isDigit(c)
      let sc=col
      let s=i
      while i<len(src) && isDigit(substr(src,i,1))
        i+=1
        col+=1
      if i<len(src) && substr(src,i,1)=="." && i+1<len(src) && isDigit(substr(src,i+1,1))
        i+=1
        col+=1
        while i<len(src) && isDigit(substr(src,i,1))
          i+=1
          col+=1
      push(out,token("number",substr(src,s,i-s),line,sc))
    else if isAlpha(c)
      let sc=col
      let s=i
      while i<len(src) && (isAlpha(substr(src,i,1)) || isDigit(substr(src,i,1)))
        i+=1
        col+=1
      push(out,token("identifier",substr(src,s,i-s),line,sc))
    else if i+1<len(src) && isTwoCharOp(c,substr(src,i+1,1))
      push(out,token("operator",c+substr(src,i+1,1),line,col))
      i+=2
      col+=2
    else
      push(out,token("symbol",c,line,col))
      i+=1
      col+=1
  return out
fn ast(kind,value,children)
  let a=put({},"kind",kind)
  a=put(a,"value",value)
  return put(a,"children",children)
fn literalAst(v)
  return ast("literal",v,[])
fn ir(op,args,typ)
  let n=put({},"op",op)
  n=put(n,"args",args)
  return put(n,"type",typ)
fn lowerLiteral(v)
  return ir("const",[v],type(v))
fn compileLexical(source,target)
  let toks=lex(source)
  return {"target":target,"tokenCount":len(toks),"tokens":toks,"status":"lexed"}
fn compilePlan(src,target)
  let lexical=compileLexical(src,target)
  return {"source":src,"target":target,"lexical":lexical,"irStatus":"front-end-lowered-only"}
